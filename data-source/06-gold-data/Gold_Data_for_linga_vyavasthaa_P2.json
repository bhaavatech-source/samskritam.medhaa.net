{
 "document_metadata": {
  "title": "शास्त्रीयलिङ्गम् (Classical Sanskrit Gender Classification)",
  "original_author": "Dr. B Rajeswara Rao",
  "institution": "Bhaavajaalam Research Center, Visakhapatnam",
  "language": "Sanskrit",
  "topic": "Gender (liṅga) classification rules in Sanskrit",
  "document_type": "Gold Data for training of Sanskrit Corpus"
 },
 "introduction": {
  "upodghatah": {
   "title": "उपोद्घातः",
   "title_english": "Introduction"
  },
  "linga_svarupam": {
   "title": "लिङ्गस्वरूपम्",
   "title_english": "Nature of Gender",
   "definition_sanskrit": "लिङ्गं नाम चिह्मम् इत्यर्थः।",
   "definition_english": "Gender (liṅga) means a marker/characteristic.",
   "worldly_understanding_sanskrit": "स्तनादिचिह्नादिमस्ति तर्हि स्त्री इति, अधिकलोमानि सन्ति चेत् पुरुष इति, एतस्माद् अन्यत् सर्वं नपुंसकमिति लोके व्यवहारः वर्तते। तादृशव्यवहाराय विविधलिङ्गेषु विभिन्नानि पदनि सन्ति।",
   "worldly_understanding_english": "In common usage, if breast-like characteristics are present, it is feminine (strī); if excessive body hair is present, it is masculine (purusha); everything else is neuter (napuṃsaka). Various words exist in different genders for such usage."
  },
  "problem": {
   "title": "अत्र समस्या",
   "title_english": "The Problem",
   "problem_statement_sanskrit": "संस्कृते तावद् इयं युक्तिः पर्याप्ता न भवति। यतः पत्नीरूपार्थं वक्तुं दाराशब्दः पुंसि बहुवचनान्तः, कळत्रशब्दः नपुंसकलिङ्गे च प्रयुज्यते। वृक्षादिशब्दाः पुंसि प्रयुज्यते। लतादिशब्दाः स्त्रियां प्रयुज्यन्ते।",
   "problem_statement_english": "In Sanskrit, this logic is not sufficient. For the meaning of 'wife', the word दारा is used in masculine plural, and कळत्र is used in neuter. Words like वृक्ष (tree) are masculine. Words like लता (creeper) are feminine.",
   "question_sanskrit": "किमर्थमेवं भवतीति।",
   "question_english": "Why is it so?"
  },
  "solution": {
   "title": "अत्र समाधानम्",
   "title_english": "The Solution",
   "principle_sanskrit": "संस्कृते शब्दानां लिङ्गं प्रत्येकं पदार्थे सत्त्वरजस्तमोगुणानामपचयोपचस्थितिभिः निश्चीयते। यत्रापचयः तत्र स्त्रीत्वम्, उपचये पुंस्त्वम्, केवलं स्थितिमात्रेण नपुंसकत्वमिति निर्णयः।",
   "principle_english": "In Sanskrit, the gender of words is determined for each entity by the diminution (apacaya), enhancement (upacaya), or stasis (sthiti) of the qualities of sattva, rajas, and tamas. Where there is diminution - femininity; in enhancement - masculinity; in mere stasis alone - neuter gender."
  }
 },
 "samasta_pada_linga_vyavastha": {
  "title": "समस्तपदेषु लिङ्गव्यवस्था",
  "title_english": "Gender System in Compound Words",
  "rules": [
   {
    "compound_type": "द्वन्द्व तत्पुरुष",
    "compound_type_english": "Dvandva and Tatpurusha compounds",
    "rule_sanskrit": "द्वन्द्वतत्पुरुषसमासयोः परपदस्य यल्लिङ्गं तदेव भवति।",
    "rule_english": "In Dvandva and Tatpurusha compounds, the gender of the final word (uttarapada) becomes the gender of the compound.",
    "examples": [
     {
      "type": "द्वन्द्व",
      "analysis_sanskrit": "सीता च रामश्च सीतारामौ। अत्र उत्तरपदस्य यत् लिङ्गं (पुंस्त्वं) तदेव समस्तपदस्य भवति।",
      "analysis_english": "Sita and Rama = Sītārāmau. Here, the gender of the final word (masculine) becomes the gender of the compound.",
      "compound": "सीतारामौ",
      "gender": "पुंस्"
     },
     {
      "type": "तत्पुरुष",
      "analysis_sanskrit": "पार्वत्याः पुत्रः पार्वतीपुत्रः। पुत्र इति उत्तरपदम्, स पुंल्लिङ्गे वर्तते इति कृत्वा समस्तपदमपि पुंलिङ्गे भवति।",
      "analysis_english": "Son of Parvati = Pārvatīputraḥ. Putra is the final word, it is in masculine, therefore the compound is also masculine.",
      "compound": "पार्वतीपुत्रः",
      "gender": "पुंस्"
     }
    ]
   },
   {
    "compound_type": "अव्ययीभाव",
    "compound_type_english": "Avyayībhāva compounds",
    "rule_sanskrit": "अव्ययीभावः सर्वदा नपुंसकलिङ्गे एव भवति।",
    "rule_english": "Avyayībhāva compounds are always neuter.",
    "examples": [
     {
      "word": "यथाशक्ति",
      "meaning": "according to capacity",
      "gender": "नपुंसकम्"
     },
     {
      "word": "उपगङ्गम्",
      "meaning": "near the Ganga",
      "gender": "नपुंसकम्"
     }
    ]
   },
   {
    "compound_type": "समाहारद्वन्द्व",
    "compound_type_english": "Samāhāra Dvandva (aggregate dvandva)",
    "rule_sanskrit": "समाहारद्वन्द्वे नपुंसकलिङ्गं भवति।",
    "rule_english": "In Samāhāra Dvandva, the gender is neuter.",
    "examples": [
     {
      "word": "पाणिपादम्",
      "meaning": "hands and feet",
      "gender": "नपुंसकम्"
     }
    ]
   },
   {
    "compound_type": "समाहारद्विगु",
    "compound_type_english": "Samāhāra Dvigu (aggregate dvigu)",
    "rule_sanskrit": "समाहारद्विगौ स्त्रीलिङ्गं भवति।",
    "rule_english": "In Samāhāra Dvigu, the gender is feminine.",
    "examples": [
     {
      "word": "त्रिलोकी",
      "meaning": "three worlds",
      "gender": "स्त्री"
     }
    ]
   },
   {
    "compound_type": "बहुव्रीहि",
    "compound_type_english": "Bahuvrīhi compounds",
    "rule_sanskrit": "बहुव्रीहिसमासे अन्यपदार्थलिङ्गमेव भवति।",
    "rule_english": "In Bahuvrīhi compounds, the gender of the external referent (not the compound itself) is used.",
    "examples": [
     {
      "compound": "पीताम्बरः",
      "full_form": "पीताम्बरो विष्णुः",
      "meaning": "One who has yellow garments (Vishnu)",
      "gender": "पुंस्"
     },
     {
      "compound": "पीताम्बरा",
      "full_form": "पीताम्बरा सरस्वती",
      "meaning": "One who has yellow garments (Saraswati)",
      "gender": "स्त्री"
     }
    ]
   }
  ]
 },
